def run_port_scanner():
    """Vector 1: High-Velocity Multi-threaded Network Reconnaissance"""
    target = input("[?] Enter target host IP/Domain (e.g., scanme.nmap.org): ").strip()
    if not target: return
    
    print(f"\n[*] Launching asynchronous scanning threads on: {target} | Pool: {THREAD_LIMIT}")
    task_queue = queue.Queue()
    open_ports = []
    
    for p in range(1, 501): task_queue.put(p)
    
    def worker():
        while not task_queue.empty():
            port = task_queue.get()
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                s.settimeout(0.5)
                if s.connect_ex((target, port)) == 0:
                    open_ports.append(port)
                s.close()
            except:
                pass
            task_queue.task_done()

    threads = []
    for _ in range(THREAD_LIMIT):
        t = threading.Thread(target=worker)
        threads.append(t)
        t.start()
        
    for t in threads: t.join()
    
    print("\n" + "="*45 + "\n           SCAN COMPLETION REPORT\n" + "="*45)
    if open_ports:
        for p in sorted(open_ports):
            print(f"[!] Target Port {p}: OPEN (Vulnerability Flagged)")
            logger.info(f"Port Scanner identified exposed port {p} on host {target}")
    else:
        print("[+] Isolation clear. No open common ports discovered.")
    logger.info(f"Reconnaissance sweep completed for host {target}")

